    "test:security": "node scripts/check-security.mjs",
    "test:vercel": "node tests/vercel-proxy-contract.cjs",
    "test:http": "node tests/vercel-proxy-http-smoke.cjs",
    "test:brand": "node tests/brand-regression.cjs",
    "test:edge-routing": "node tests/edge-routing-regression.cjs",
    "test:guidance": "node tests/login-code-guidance-regression.cjs",
    "test:remember": "node tests/remember-session-regression.cjs",
    "test:dev-proxy": "node tests/vite-dev-proxy-regression.cjs",
    "test:session-crypto": "node tests/session-token-crypto-regression.cjs",
    "test:vite-dev-http": "node tests/vite-dev-api-http-smoke.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test:publishable-key": "node tests/publishable-key-regression.cjs"
